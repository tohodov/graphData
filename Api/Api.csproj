<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TypeScriptToolPath>$(MSBuildProjectDirectory)\node_modules\.bin</TypeScriptToolPath>
    <VisualStudioNodeToolPath>MSBuild\Microsoft\VisualStudio\NodeJs</VisualStudioNodeToolPath>
    <NodeExe Condition="'$(NodeExe)' == '' and Exists('$(VSINSTALLDIR)$(VisualStudioNodeToolPath)\node.exe')">$(VSINSTALLDIR)$(VisualStudioNodeToolPath)\node.exe</NodeExe>
    <NodeExe Condition="'$(NodeExe)' == '' and Exists('$(VsInstallRoot)\$(VisualStudioNodeToolPath)\node.exe')">$(VsInstallRoot)\$(VisualStudioNodeToolPath)\node.exe</NodeExe>
    <NodeExe Condition="'$(NodeExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(VisualStudioNodeToolPath)\node.exe')">$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(VisualStudioNodeToolPath)\node.exe</NodeExe>
    <NodeExe Condition="'$(NodeExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(VisualStudioNodeToolPath)\node.exe')">$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(VisualStudioNodeToolPath)\node.exe</NodeExe>
    <NodeExe Condition="'$(NodeExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(VisualStudioNodeToolPath)\node.exe')">$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(VisualStudioNodeToolPath)\node.exe</NodeExe>
    <NodeExe Condition="'$(NodeExe)' == ''">node</NodeExe>
    <NpmExe Condition="'$(NpmExe)' == '' and Exists('$(VSINSTALLDIR)$(VisualStudioNodeToolPath)\npm.cmd')">$(VSINSTALLDIR)$(VisualStudioNodeToolPath)\npm.cmd</NpmExe>
    <NpmExe Condition="'$(NpmExe)' == '' and Exists('$(VsInstallRoot)\$(VisualStudioNodeToolPath)\npm.cmd')">$(VsInstallRoot)\$(VisualStudioNodeToolPath)\npm.cmd</NpmExe>
    <NpmExe Condition="'$(NpmExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(VisualStudioNodeToolPath)\npm.cmd')">$(ProgramFiles)\Microsoft Visual Studio\2022\Community\$(VisualStudioNodeToolPath)\npm.cmd</NpmExe>
    <NpmExe Condition="'$(NpmExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(VisualStudioNodeToolPath)\npm.cmd')">$(ProgramFiles)\Microsoft Visual Studio\2022\Professional\$(VisualStudioNodeToolPath)\npm.cmd</NpmExe>
    <NpmExe Condition="'$(NpmExe)' == '' and Exists('$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(VisualStudioNodeToolPath)\npm.cmd')">$(ProgramFiles)\Microsoft Visual Studio\2022\Enterprise\$(VisualStudioNodeToolPath)\npm.cmd</NpmExe>
    <NpmExe Condition="'$(NpmExe)' == ''">npm</NpmExe>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.21" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\Core.csproj" />
    <ProjectReference Include="..\SymLinkStorage\SymLinkStorage.csproj" />
  </ItemGroup>

  <Target Name="RestoreTypeScriptTooling"
          BeforeTargets="BuildTypeScript"
          Inputs="$(MSBuildProjectDirectory)\package.json"
          Outputs="$(MSBuildProjectDirectory)\node_modules\.bin\tsc.cmd"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="&quot;$(NpmExe)&quot; install --no-audit --no-fund --no-package-lock" />
  </Target>

  <Target Name="BuildTypeScript" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(NodeExe)&quot; &quot;node_modules\typescript\lib\tsc.js&quot; -p tsconfig.json" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\js" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)"
          Command="&quot;$(NodeExe)&quot; &quot;node_modules\esbuild\bin\esbuild&quot; obj/ts/main.js --bundle --sourcemap --outfile=wwwroot/js/app.js" />
  </Target>

</Project>
