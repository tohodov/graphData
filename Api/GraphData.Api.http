@GraphData.Api_HostAddress = https://localhost:7257

### Create a node
POST {{GraphData.Api_HostAddress}}/api/graph/raw/nodes
Content-Type: application/json

{
  "localId": "Sample node",
  "attributes": {
    "type": "example"
  }
}

### Get node details
# Repeat globalId for multi-segment ids, for example: ?globalId=Parent&globalId=Child
GET {{GraphData.Api_HostAddress}}/api/graph/raw/nodes?globalId=Sample%20node
Accept: application/json

### Connect two nodes
POST {{GraphData.Api_HostAddress}}/api/graph/raw/connections
Content-Type: application/json

{
  "node1InternalId": [ "Sample node" ],
  "node2InternalId": [ "Another node" ]
}

### Update node attributes
PUT {{GraphData.Api_HostAddress}}/api/graph/raw/nodes?globalId=Sample%20node
Content-Type: application/json

{
  "attributes": {
    "type": "updated"
  }
}

### Delete node
DELETE {{GraphData.Api_HostAddress}}/api/graph/raw/nodes?globalId=Sample%20node

### Search nodes
POST {{GraphData.Api_HostAddress}}/api/graph/raw/search/nodes
Content-Type: application/json
Accept: application/x-ndjson

{
  "return": [ "n" ],
  "where": {
    "kind": "text",
    "node": { "kind": "var", "name": "n" },
    "value": "Sample"
  },
  "limit": 20
}

### Load subgraph
POST {{GraphData.Api_HostAddress}}/api/graph/raw/subgraph
Content-Type: application/json

{
  "paths": [[ "Sample node" ]],
  "maxDepth": 1
}

### Load semantic type catalog
POST {{GraphData.Api_HostAddress}}/api/graph/semantic/types
Content-Type: application/json

{
  "roots": [[ "NodeTypes" ]]
}
