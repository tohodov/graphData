@GraphData.Api_HostAddress = http://localhost:5058

### Create a node
POST {{GraphData.Api_HostAddress}}/api/graph/nodes
Content-Type: application/json

{
  "name": "Sample node",
  "attributes": {
    "type": "example"
  }
}

### Get node details
# Replace Sample%20node with an existing node name
GET {{GraphData.Api_HostAddress}}/api/graph/nodes?name=Sample%20node
Accept: application/json

### Connect two nodes
POST {{GraphData.Api_HostAddress}}/api/graph/connections
Content-Type: application/json

{
  "sourceName": "Sample node",
  "targetName": "Another node"
}

### Update node attributes
PUT {{GraphData.Api_HostAddress}}/api/graph/nodes?name=Sample%20node
Content-Type: application/json

{
  "attributes": {
    "type": "updated"
  }
}

### Delete node
DELETE {{GraphData.Api_HostAddress}}/api/graph/nodes?name=Sample%20node

### Search nodes
POST {{GraphData.Api_HostAddress}}/api/graph/search/nodes
Content-Type: application/json

{
  "return": [ "n" ],
  "where": {
    "kind": "text",
    "node": { "kind": "var", "name": "n" },
    "value": "Sample"
  },
  "limit": 20
}

### Stream search node matches
POST {{GraphData.Api_HostAddress}}/api/graph/search/nodes/stream
Content-Type: application/json

{
  "return": [ "n" ],
  "where": {
    "kind": "node",
    "node": { "kind": "var", "name": "n" }
  },
  "limit": 20
}

### Load subgraph
POST {{GraphData.Api_HostAddress}}/api/graph/subgraph
Content-Type: application/json

{
  "rootNodeIds": [ "Sample node" ],
  "maxDepth": 1,
  "includeDisconnectedRoots": true
}
