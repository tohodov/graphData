@GraphData.Api_HostAddress = http://localhost:5058

### Create a node
POST {{GraphData.Api_HostAddress}}/api/graph/nodes
Content-Type: application/json

{
  "name": "Sample node",
  "attributes": {
    "type": "example"
  }
}

### Get node details
# Repeat path for child paths, for example: ?path=Parent&path=Child
GET {{GraphData.Api_HostAddress}}/api/graph/nodes?path=Sample%20node
Accept: application/json

### Connect two nodes
POST {{GraphData.Api_HostAddress}}/api/graph/connections
Content-Type: application/json

{
  "sourcePath": [ "Sample node" ],
  "targetPath": [ "Another node" ]
}

### Update node attributes
PUT {{GraphData.Api_HostAddress}}/api/graph/nodes?path=Sample%20node
Content-Type: application/json

{
  "attributes": {
    "type": "updated"
  }
}

### Delete node
DELETE {{GraphData.Api_HostAddress}}/api/graph/nodes?path=Sample%20node

### Search nodes
POST {{GraphData.Api_HostAddress}}/api/graph/search/nodes
Content-Type: application/json
Accept: application/x-ndjson

{
  "return": [ "n" ],
  "where": {
    "kind": "text",
    "node": { "kind": "var", "name": "n" },
    "value": "Sample"
  },
  "limit": 20
}

### Load subgraph
POST {{GraphData.Api_HostAddress}}/api/graph/subgraph
Content-Type: application/json

{
  "rootPaths": [[ "Sample node" ]],
  "maxDepth": 1,
  "includeDisconnectedRoots": true
}
