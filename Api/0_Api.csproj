<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Api</AssemblyName>
    <AssemblyTitle>Api</AssemblyTitle>
    <RootNamespace>Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.21" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\1_ Domain.csproj" />
    <ProjectReference Include="..\SymLinkStorage\1_SymLinkStorage.csproj" />
  </ItemGroup>

  <Target Name="RestoreTypeScriptTooling" BeforeTargets="BuildTypeScript" Inputs="$(MSBuildProjectDirectory)\package.json;$(MSBuildProjectDirectory)\package-lock.json" Outputs="$(MSBuildProjectDirectory)\node_modules\.bin\tsc.cmd" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm ci --no-audit --no-fund" />
  </Target>

  <Target Name="BuildTypeScript" BeforeTargets="CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <TypeScriptCompilerOutput Remove="@(TypeScriptCompilerOutput)" />
      <EsbuildOutput Remove="@(EsbuildOutput)" />
    </ItemGroup>
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run build" ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="High" StandardErrorImportance="High">
      <Output TaskParameter="ConsoleOutput" ItemName="TypeScriptCompilerOutput" />
      <Output TaskParameter="ExitCode" PropertyName="TypeScriptExitCode" />
    </Exec>
    <Error Condition="'$(TypeScriptExitCode)' != '0'" Text="TypeScript compiler failed with exit code $(TypeScriptExitCode):%0A@(TypeScriptCompilerOutput, '%0A')" />
    <ItemGroup>
      <WgslSource Include="wwwroot\**\*.wgsl" />
    </ItemGroup>
    <MakeDir Directories="@(WgslSource->'$(MSBuildProjectDirectory)\obj\ts\%(RecursiveDir)')" />
    <Copy SourceFiles="@(WgslSource)" DestinationFiles="@(WgslSource->'$(MSBuildProjectDirectory)\obj\ts\%(RecursiveDir)%(Filename)%(Extension)')" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\wwwroot\js" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="npm run bundle" ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="High" StandardErrorImportance="High">
      <Output TaskParameter="ConsoleOutput" ItemName="EsbuildOutput" />
      <Output TaskParameter="ExitCode" PropertyName="EsbuildExitCode" />
    </Exec>
    <Error Condition="'$(EsbuildExitCode)' != '0'" Text="esbuild failed with exit code $(EsbuildExitCode):%0A@(EsbuildOutput, '%0A')" />
  </Target>

</Project>
