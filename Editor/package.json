{
  "name": "editor",
  "version": "1.0.0",
  "private": true,
  "description": "GraphData browser editor",
  "main": "main.js",
  "scripts": {
    "build": "npm run generate:api-types && tsc --build && npm run bundle",
    "bundle": "esbuild main.ts --bundle --sourcemap --loader:.wgsl=text --outfile=../Api/wwwroot/js/app.js",
    "clean": "tsc --build --clean",
    "generate:api-types": "openapi-typescript ../Api/obj/openapi.json -o src/generated/openapi-types.ts"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.71",
    "esbuild": "0.28.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3"
  }
}
