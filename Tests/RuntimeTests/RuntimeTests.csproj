<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RelevantTests\src\RelevantTests.MSTest\build\RelevantTests.MSTest.props" />
  <Import Project="..\RelevantTests\src\RelevantTests.MSTest\build\RelevantTests.MSTest.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>GraphCompiler.RuntimeTests</AssemblyName>
    <RelevantTestsCurrentRoot>$(MSBuildProjectDirectory)\..\..</RelevantTestsCurrentRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.3.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.3.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="RelevantTests.MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Compiler\GraphCompiler.csproj" />
    <ProjectReference Include="..\..\Domain\1_ Domain.csproj" />
    <ProjectReference Include="..\..\Runtime\GraphCompiler.Runtime.csproj" />
    <ProjectReference Include="..\RelevantTests\src\RelevantTests.MSTest\RelevantTests.MSTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RelevantTestsTargetProject Include="..\..\Compiler\GraphCompiler.csproj" TargetAssembly="GraphCompiler" />
    <RelevantTestsTargetProject Include="..\..\Domain\1_ Domain.csproj" TargetAssembly="Domain" />
    <RelevantTestsTargetProject Include="..\..\Runtime\GraphCompiler.Runtime.csproj" TargetAssembly="GraphCompiler.Runtime" />
  </ItemGroup>
</Project>
