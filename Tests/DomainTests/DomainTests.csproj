<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\RelevantTests\src\RelevantTests.MSTest\build\RelevantTests.MSTest.props" />
  <Import Project="..\RelevantTests\src\RelevantTests.MSTest\build\RelevantTests.MSTest.targets" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>DomainTests</AssemblyName>
    <RelevantTestsCurrentRoot>$(MSBuildProjectDirectory)\..</RelevantTestsCurrentRoot>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.3.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.3.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Abstractions.NodeRef.InternalId">
      <Alias>InternalId</Alias>
    </Using>
    <Using Include="Abstractions.NodeRef.NodePath">
      <Alias>NodePath</Alias>
    </Using>
    <Using Include="RelevantTests.MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\..\Domain\1_ Domain.csproj" />
    <ProjectReference Include="..\..\SymLinkStorage\1_SymLinkStorage.csproj" />
    <ProjectReference Include="..\RelevantTests\src\RelevantTests.MSTest\RelevantTests.MSTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RelevantTestsTargetProject Include="..\Abstractions\Abstractions.csproj" TargetAssembly="Abstractions" />
    <RelevantTestsTargetProject Include="..\Domain\Domain.csproj" TargetAssembly="Domain" />
    <RelevantTestsTargetProject Include="..\SymLinkStorage\SymLinkStorage.csproj" TargetAssembly="SymLinkStorage" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\CancellationTokensAccessorMock.cs" Link="CancellationTokensAccessorMock.cs" />
  </ItemGroup>

</Project>
