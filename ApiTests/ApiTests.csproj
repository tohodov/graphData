<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\TestImpactOnCoverage\src\RelevantTests.MSTest\build\RelevantTests.MSTest.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>ApiTests</AssemblyName>
    <RelevantTestsCurrentRoot>$(MSBuildProjectDirectory)\..</RelevantTestsCurrentRoot>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.10.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.3.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.3.1" />
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Abstractions.NodeRef.InternalId">
      <Alias>InternalId</Alias>
    </Using>
    <Using Include="Abstractions.NodeRef.NodePath">
      <Alias>NodePath</Alias>
    </Using>
    <Using Include="RelevantTests.MSTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Abstractions\Abstractions.csproj" />
    <ProjectReference Include="..\Api\Api.csproj" />
    <ProjectReference Include="..\Domain\Domain.csproj" />
    <ProjectReference Include="..\Mcp\Mcp.csproj" />
    <ProjectReference Include="..\SymLinkStorage\SymLinkStorage.csproj" />
    <ProjectReference Include="..\TestImpactOnCoverage\src\RelevantTests.MSTest\RelevantTests.MSTest.csproj" />
  </ItemGroup>

  <ItemGroup>
    <RelevantTestsTargetProject Include="..\Abstractions\Abstractions.csproj" TargetAssembly="Abstractions" />
    <RelevantTestsTargetProject Include="..\Domain\Domain.csproj" TargetAssembly="Domain" />
    <RelevantTestsTargetProject Include="..\SymLinkStorage\SymLinkStorage.csproj" TargetAssembly="SymLinkStorage" />
    <RelevantTestsTargetProject Include="..\Api\Api.csproj" TargetAssembly="Api" />
    <RelevantTestsTargetProject Include="..\Mcp\Mcp.csproj" TargetAssembly="Mcp" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\TestSupport\CancellationTokensAccessorMock.cs" Link="CancellationTokensAccessorMock.cs" />
    <Compile Include="..\TestSupport\TestGraphStorageScope.cs" Link="TestGraphStorageScope.cs" />
  </ItemGroup>

  <Import Project="..\TestImpactOnCoverage\src\RelevantTests.MSTest\build\RelevantTests.MSTest.targets" />
</Project>
